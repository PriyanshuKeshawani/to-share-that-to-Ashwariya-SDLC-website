# ==============================================================================
# SISTEC Central Digital Library Portal — Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' or '.env.local' (or into client/.env.local):
#   cp .env.example client/.env.local
#
# IMPORTANT SECURITY NOTICE:
# - NEVER commit real credentials, service-role keys, or secret tokens to Git.
# - All keys starting with NEXT_PUBLIC_ are exposed to client-side browser code.
# - Access control MUST be governed via Supabase Row-Level Security (RLS) policies.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE POSTGRESQL & AUTH CONFIGURATION
# Obtain from: Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
# Your Supabase project URL (e.g., https://your-project-id.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase anonymous (public) API key (governed by Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ------------------------------------------------------------------------------
# 2. FIREBASE CLOUD MESSAGING & PUSH NOTIFICATIONS
# Obtain from: Firebase Console -> Project Settings -> General -> Web Apps
# ------------------------------------------------------------------------------
# Firebase Web API Key
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here

# Firebase Auth Domain
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com

# Firebase Project ID
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id

# Firebase Storage Bucket
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-app.firebasestorage.app

# Firebase Messaging Sender ID (Project Number)
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here

# Firebase Web App ID
NEXT_PUBLIC_FIREBASE_APP_ID=1:your_sender_id:web:your_app_id_here

# Firebase Web Push VAPID Key (Public Key)
# Obtain from: Firebase Console -> Project Settings -> Cloud Messaging -> Web Push certificates
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your_firebase_vapid_key_here
