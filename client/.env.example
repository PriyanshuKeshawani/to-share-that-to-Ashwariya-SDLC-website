# ==============================================================================
# SAGAR INSTITUTE OF SCIENCE & TECHNOLOGY (SISTEC) — CENTRAL DIGITAL LIBRARY PORTAL
# CONFIDENTIAL & PROPRIETARY — FOR SISTEC COLLEGE VPS & INTERNAL INFRASTRUCTURE ONLY
# ==============================================================================
# This configuration file is intended strictly for the SISTEC College Administration,
# IT Cell, and Authorized Developers. Do NOT redistribute publicly.
#
# Production Setup on College Hostinger VPS (Ubuntu 22.04):
# 1. Copy this file to .env.local:
#      cp .env.example .env.local
# 2. Enter your live college Supabase credentials below.
# 3. Build and launch with PM2 cluster:
#      npm run build
#      npm run start:cluster
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE DATABASE & AUTHENTICATION (PostgreSQL Backend)
# Obtain from: Supabase Console -> Project Settings -> API
# ------------------------------------------------------------------------------
# College Supabase Project URL (e.g., https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-sistec-project-id.supabase.co

# College Supabase Public Anon Key (Protected by PostgreSQL Row-Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ------------------------------------------------------------------------------
# 2. FIREBASE CLOUD MESSAGING (Push Notifications for Students & Admins)
# Obtain from: Firebase Console -> Project Settings -> General & Cloud Messaging
# ------------------------------------------------------------------------------
# Firebase Web API Key
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key_here

# Firebase Auth Domain (e.g., sistec-library.firebaseapp.com)
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=sistec-library-portal.firebaseapp.com

# Firebase Project ID
NEXT_PUBLIC_FIREBASE_PROJECT_ID=sistec-library-portal

# Firebase Storage Bucket Domain
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=sistec-library-portal.firebasestorage.app

# Firebase Messaging Sender ID (Numerical Project Number)
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_numerical_sender_id

# Firebase Web App ID (format: 1:xxxxx:web:xxxxx)
NEXT_PUBLIC_FIREBASE_APP_ID=1:your_sender_id:web:your_web_app_id

# Firebase Web Push VAPID Public Key (From Cloud Messaging -> Web Push certificates)
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your_firebase_vapid_key_here
